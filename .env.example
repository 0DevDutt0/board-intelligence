# /home/claude/board-intelligence/.env.example
# Copy this to .env and fill in values before running.
# Never commit .env to version control.

# ── Session Security ──────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# ── vLLM Service ──────────────────────────────────────────────────────────
VLLM_BASE_URL=http://vllm:11436
VLLM_MODEL=qwen3-14b
VLLM_MAX_TOKENS=1024
VLLM_TEMPERATURE=0.1
VLLM_TIMEOUT_SECONDS=60

# ── Model Paths (inside container, mapped from ./models) ─────────────────
EMBEDDING_MODEL=/models/bge-m3
RERANKER_MODEL=/models/bge-reranker-v2-m3
NLI_MODEL=/models/nli-deberta-v3-small
DOCLING_ARTIFACTS=/models/docling-models

# ── Hardware ─────────────────────────────────────────────────────────────
DEVICE=cuda
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DTYPE=float16

# ── Retrieval Parameters ─────────────────────────────────────────────────
DENSE_TOP_K=50
SPARSE_TOP_K=50
RRF_K=60
RERANKER_TOP_K=5
USE_HYDE=true
HYDE_MIN_QUERY_WORDS=6

# ── Chunking Parameters ───────────────────────────────────────────────────
CHUNK_TARGET_TOKENS=500
CHUNK_MIN_TOKENS=100
CHUNK_OVERLAP_TOKENS=50
TABLE_MAX_TOKENS=1024

# ── Hallucination Guard ───────────────────────────────────────────────────
NLI_ENTAILMENT_THRESHOLD=0.70
NUMERIC_VERIFICATION=true

# ── Session Management ────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
MAX_CONVERSATION_HISTORY=3
TEMP_SESSION_DIR=/tmp/bis-sessions
MAX_UPLOAD_MB=100

# ── API ───────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Set to false in production to avoid logging query content
LOG_QUERIES=false
