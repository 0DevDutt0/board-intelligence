# .env.example
# Copy to .env from the repo root. Keep your .env out of version control.

# -- Session Security ------------------------------------------------------
# The backend generates a fresh key at startup by default.
# To set your own, use python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET_KEY=

# -- vLLM Service (runs in WSL, reachable on localhost) ---------------------
VLLM_BASE_URL=http://127.0.0.1:11436
VLLM_MODEL=qwen3-14b

# -- Model paths relative to the repository root ----------------------------
EMBEDDING_MODEL=models/bge-m3
RERANKER_MODEL=models/bge-reranker-v2-m3
NLI_MODEL=models/nli-deberta-v3-small
DOCLING_ARTIFACTS=models/docling-models

# -- Hardware ---------------------------------------------------------------
DEVICE=cuda

# -- Session Management -----------------------------------------------------
MAX_UPLOAD_MB=100

# -- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Keep false in production to avoid logging query content
LOG_QUERIES=false
