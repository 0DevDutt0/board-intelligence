# .env.example
# Copy this to .env and fill in values before running.
# Never commit .env to version control.
#
# Only put values here that differ from the defaults in src/utils/config.py.
# Tuned retrieval parameters (reranker_top_k, bm25_k1, hyde settings, ...)
# live in config.py -- do not override them here unless deliberately re-tuning.

# -- Session Security ------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-generate-with-secrets-token-hex-32

# -- vLLM Service (runs in WSL, reachable on localhost) ---------------------
VLLM_BASE_URL=http://127.0.0.1:11436
VLLM_MODEL=qwen3-14b

# -- Model Paths (absolute Windows paths, forward slashes) ------------------
EMBEDDING_MODEL=E:/work/Resnova/board-intelligence/models/bge-m3
RERANKER_MODEL=E:/work/Resnova/board-intelligence/models/bge-reranker-v2-m3
NLI_MODEL=E:/work/Resnova/board-intelligence/models/nli-deberta-v3-small
DOCLING_ARTIFACTS=E:/work/Resnova/board-intelligence/models/docling-models

# -- Hardware ---------------------------------------------------------------
DEVICE=cuda

# -- Session Management -----------------------------------------------------
# Windows-local directory for ephemeral session temp files
TEMP_SESSION_DIR=C:/Users/you/AppData/Local/bis-sessions

# -- API ---------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Keep false in production to avoid logging query content
LOG_QUERIES=false
