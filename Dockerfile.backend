# /home/claude/board-intelligence/Dockerfile.backend
# FastAPI backend with all inference models except the main LLM.
# CUDA 12.8 base - mandatory for Blackwell sm_120 stability.

FROM nvcr.io/nvidia/pytorch:25.02-py3

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Force CUDA 12.8 toolkit path
ENV PATH=/usr/local/cuda-12.8/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:${LD_LIBRARY_PATH}

# Disable all telemetry
ENV ANONYMIZED_TELEMETRY=False
ENV TOKENIZERS_PARALLELISM=false
ENV HF_DATASETS_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV HF_HUB_OFFLINE=1

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
# PyTorch cu128 must come first to avoid version conflicts
RUN pip install --no-cache-dir \
    torch>=2.9.0 \
    torchvision \
    --index-url https://download.pytorch.org/whl/cu128

# Pin numpy<2.0 before requirements -- packages compiled with NumPy 1.x crash on 2.x
RUN pip install --no-cache-dir "numpy>=1.26.0,<2.0"

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY src/ ./src/

# Create temp session directory
RUN mkdir -p /tmp/bis-sessions && chmod 700 /tmp/bis-sessions

# Print torch version for build log (GPU not available at build time, checked at runtime)
RUN python3 -c "import torch; print(f'PyTorch {torch.__version__}, CUDA build: {torch.version.cuda}')"

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", \
     "--host", "127.0.0.1", \
     "--port", "8000", \
     "--workers", "1", \
     "--log-level", "info"]
